# Public Supabase project settings used to build the GitHub Pages site.
# Configure the same names as GitHub Actions repository secrets.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-public-anon-key"
VITE_BASE_PATH="/lista-de-presentes/"

# Never put a Supabase service_role/secret key in VITE_* variables or the browser.
