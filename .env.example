# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Admin login (never use a weak/reused password; at least 12 characters)
ADMIN_USERNAME="your-admin-user"
ADMIN_PASSWORD="replace-with-a-unique-password-of-12-or-more-characters"

# Supabase public settings (the anon key is intended to be public)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-public-anon-key"

# Private server-side key. Never expose this value to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY="your-private-service-role-key"
